# Get a key at https://console.anthropic.com/ and save this file as .env
ANTHROPIC_API_KEY=
API_PORT=8787

# Store access codes for the AI assistant, comma-separated, 6+ characters each.
# One per store, e.g. ACCESS_CODES=aling-nena-7k2p,mang-ben-q9x4. With none set, the assistant is off.
ACCESS_CODES=

# Set to 1 when running behind a host's proxy (Render, Railway, Fly) so rate limits see the phone's IP.
TRUST_PROXY=0
